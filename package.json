{
  "name": "screen-buddy",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Claude Code plugin: every agent session gets its own on-screen buddy that can see your screen, point, talk, and follow along",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "node test/smoke.mjs",
    "test:look": "node test/look.mjs",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "33.4.11",
    "esbuild": "^0.24.2",
    "typescript": "^5.6.0"
  }
}
